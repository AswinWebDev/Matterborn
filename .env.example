# Copy this file to .env and paste your key from https://labs.aholo.ai/api-keys
# Never commit .env. One key works for both the asset generator and the aholo-lux3d skill.
AHOLO_API_KEY=
AHOLO_REGION=com
# Same key again, under the name the aholo-lux3d skill reads (international region):
LUX3D_GLOBAL_API_KEY=

# ElevenLabs key for voice lines, sound effects and music (pipeline/eleven.mjs):
ELEVENLABS_API_KEY=
